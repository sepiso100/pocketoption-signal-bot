# --- Safe defaults ---
PO_MODE=paper
PO_SYMBOL=EURUSD_otc
PO_TIMEFRAME_SEC=60
PO_EXPIRY_SEC=60
PO_SIGNAL_INTERVAL_SEC=360
PO_SIGNAL_MIN_ALIGNMENT=70
PO_SIGNAL_TIMEZONE=Africa/Lusaka

# --- Signal-only broadcasting (never places trades) ---
# Set PO_MODE=signals only after both services are configured.
# SIGNAL_INGEST_URL=https://<pass-keys-render-host>/v1/signals
# SIGNAL_INGEST_TOKEN=<same-random-secret-on-both-services-at-least-32-characters>
# PO_SESSION=<demo-account-session>
# PO_UID=<numeric-demo-account-id>
# PO_IS_DEMO=true
# PO_REGION=DEMO
# Auth field test: default sessionToken; set to session for one controlled demo test.
# PO_AUTH_SESSION_FIELD=sessionToken

# --- Optional authenticated Render control API ---
# Missing token disables control commands (health remains available).
# SIGNAL_CONTROL_TOKEN=<different-random-secret-at-least-32-characters>
# SIGNAL_CONTROL_HOST=0.0.0.0
# PORT=8080
